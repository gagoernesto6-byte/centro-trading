": "67,9 %", "usa": ["utilidad_bruta", "ingresos"]}, {"titulo": "Margen operativo", "texto": "Después de pagar todos sus gastos (sueldos, I+D, ventas) le quedan $47 de cada $100.", "valor": "46,8 %", "usa": ["utilidad_operativa", "ingresos"]}, {"titulo": "Apuesta al futuro (I+D)", "texto": "Gasta el 10,7 % de sus ventas en investigación y desarrollo.", "valor": "10,7 %", "usa": ["id", "ingresos"]}, {"titulo": "Caja neta", "texto": "Tiene $36.549 M más en efectivo e inversiones que en deudas.", "valor": "$36.549 M", "usa": ["caja", "inversiones_cp", "deuda_lp", "deuda_cp"]}, {"titulo": "Impuestos", "texto": "Pagó una tasa efectiva de impuestos de 19,4 % sobre sus ganancias.", "valor": "19,4 %", "usa": ["impuestos", "utilidad_neta"]}, {"titulo": "Compras de otras empresas", "texto": "El 16 % de sus activos es plusvalía (goodwill): lo que pagó de más al comprar otras empresas.", "valor": "15,8 %", "usa": ["goodwill", "activos"]}], "total_claves": 25, "total_cifras": 80, "sin_traducir": []}